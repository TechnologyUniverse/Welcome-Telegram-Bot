# Required secret: Telegram Bot API token. Set locally; never commit the real value.
BOT_TOKEN=
# Project display name used in welcome messages.
PROJECT_NAME=Technology Universe
# Storage link shown by the bot.
STORAGE_URL=https://example.com/storage
# Message deletion delay in production, in seconds.
AUTO_DELETE_SECONDS=60
# New member mute duration, in seconds.
MUTE_SECONDS=120
# Mute new users when permissions and join type allow it (true/false).
MUTE_NEW_USERS=true
# Comma-separated Telegram administrator user IDs.
ADMIN_IDS=
# Comma-separated permitted group/chat IDs. Empty means all chats are allowed.
ALLOWED_CHAT_IDS=
# Delay before sending welcome messages, in seconds.
WELCOME_DELAY_SECONDS=3
# Optional FAQ link.
FAQ_URL=
# Optional support link.
SUPPORT_URL=
# Runtime mode: prod or test.
BOT_MODE=prod
# Optional Telegram file_id or image URL for welcome messages.
WELCOME_IMAGE_URL=
# Persistent runtime data directory.
DATA_DIR=/data
# Production image reference. Set to the immutable digest printed by docker.yml.
WELCOME_BOT_IMAGE=
