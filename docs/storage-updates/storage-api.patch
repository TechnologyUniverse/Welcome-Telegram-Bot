+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtempSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {storageFeed,eligible} from '../server/storage-feed.mjs';
+import {openDB} from '../server/db.mjs';
+test('storage feed: opt-in, scoped auth, completed files only',async()=>{
+ const dir=mkdtempSync(join(tmpdir(),'storage-feed-'));const db=openDB(dir);
+ try {
+  db.prepare("INSERT INTO meta VALUES('indexed_at','now')").run();
+  db.prepare('INSERT INTO files(id,key,size,etag,folder) VALUES(?,?,?,?,0)').run('file','Программы для Mac/a.dmg',10,'etag');
+  db.prepare('INSERT INTO files(id,key,size,etag,folder) VALUES(?,?,?,?,0)').run('secret','Программы для Mac/.env',10,'secret');
+  const env={STORAGE_EVENTS_API_TOKEN:'x'.repeat(40),STORAGE_EVENTS_ALLOWED_PREFIXES:'Программы для Mac/'};
+  const req={headers:{authorization:'Bearer '+env.STORAGE_EVENTS_API_TOKEN}},url=new URL('https://local/api/integrations/storage-updates');
+  await assert.rejects(storageFeed(req,url,db,{},{}));
+  await assert.rejects(storageFeed({headers:{}},url,db,{},env));
+  const result=await storageFeed(req,url,db,{},env);assert.equal(result.files.length,1);assert.equal(result.root,'Для канала/');
+  url.searchParams.set('id','file');const storage={head:async()=>({ContentLength:10,ETag:'etag'})};
+  assert.equal((await storageFeed(req,url,db,storage,env)).available,true);
+  db.prepare("INSERT INTO uploads(id,key,status) VALUES('upload','Программы для Mac/a.dmg','uploading')").run();
+  assert.equal((await storageFeed(req,url,db,storage,env)).available,false);
+  for(const key of ['Программы для Mac/config.json','Программы для Mac/credentials.zip','Программы для Mac/../a.dmg','private/a.dmg'])assert.equal(eligible(key,['Программы для Mac/']),false);
+ } finally {db.close();rmSync(dir,{recursive:true,force:true});}
+});
