+// Opt-in, read-only metadata feed for the existing Welcome Bot. No download credentials.
+import {timingSafeEqual} from 'node:crypto';
+import {all, get} from './db.mjs';
+import {Fault} from './security.mjs';
+const blocked = /(^|\/)(\.|private(?:\/|$)|secrets?(?:\/|$)|backups?(?:\/|$)|configs?(?:\/|$)|credentials(?:\/|$)|node_modules(?:\/|$))|\.(env|pem|key|p12|pfx|sqlite|db|sql|dump|toml|ini|ya?ml|conf|config|json|part|partial|tmp|crdownload|download|swp)$/i;
+export function eligible(key, prefixes) {
+  return typeof key === 'string' && !key.startsWith('/') && !/[\\\x00-\x1f]/.test(key) && !key.split('/').some(x=>x==='..'||x==='') && !blocked.test(key) && !/^(secrets?|tokens?|passwords?|credentials|backups?|configs?)\./i.test(key.split('/').pop()) && prefixes.some(p=>key.startsWith(p));
+}
+export async function storageFeed(req, url, db, s3, env=process.env) {
+  const secret = env.STORAGE_EVENTS_API_TOKEN || '';
+  if(secret.length < 32) throw new Fault(404,'Not found');
+  const expected=Buffer.from('Bearer '+secret), supplied=Buffer.from(req.headers.authorization||'');
+  if(expected.length!==supplied.length || !timingSafeEqual(expected,supplied)) throw new Fault(401,'Unauthorized');
+  const prefixes=(env.STORAGE_EVENTS_ALLOWED_PREFIXES||'').split('|').map(s=>s.trim()).filter(Boolean);
+  if(!prefixes.length || prefixes.some(p=>!p.endsWith('/')||p.startsWith('/')||p.includes('..'))) throw new Fault(503,'Feed not configured');
+  const root=env.S3_PREFIX||'Для канала/';
+  const indexed=get(db,"SELECT value FROM meta WHERE key='indexed_at'")?.value;
+  const jobs=!!get(db,"SELECT id FROM jobs WHERE status IN ('queued','running','failed') LIMIT 1");
+  const uploads=all(db,"SELECT key FROM uploads WHERE status NOT IN ('done','cancelled','aborted')");
+  const busy=new Set(uploads.map(x=>x.key));
+  const id=url.searchParams.get('id');
+  if(id){
+    const f=get(db,'SELECT id,key,size,etag,folder FROM files WHERE id=?',id);
+    if(!f || f.folder || !eligible(f.key,prefixes) || busy.has(f.key) || jobs) return {available:false};
+    try {
+      const h=await s3.head(f.key);
+      return {available:h.ContentLength===f.size && h.ETag===f.etag, size:h.ContentLength,etag:h.ETag};
+    } catch(e){if(e.$metadata?.httpStatusCode===404)return {available:false};throw new Fault(503,'Storage unavailable');}
+  }
+  return {schema:1,root,ready:!!indexed&&!jobs,uploading:uploads.some(x=>eligible(x.key,prefixes)),files:all(db,'SELECT id,key,size,etag,modified FROM files WHERE folder=0').filter(f=>eligible(f.key,prefixes)).map(f=>({id:f.id,path:f.key,size:f.size,etag:f.etag,modified:f.modified,busy:busy.has(f.key)}))};
+}
